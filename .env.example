# Copy to .env.local for local dev, and set the same keys in Vercel → Settings → Environment Variables.

# Resend — powers the /contact form. Without it, submissions are logged to the
# server console instead of emailed (the form still shows success).
# Get a key at https://resend.com → API Keys
RESEND_API_KEY=

# Where contact-form enquiries are delivered. Defaults to the address in
# content/site.ts if unset.
CONTACT_TO_EMAIL=pixeldevsolutions@gmail.com

# Public site origin. Used for canonical URLs, sitemap, and OG tags.
NEXT_PUBLIC_SITE_URL=https://pixeldevsolutions.tech

# Signs the contact form's anti-bot token (lib/form-token.ts). At least 32
# characters, random, and never committed. Without it the form still works and
# still rejects instant bot submissions, but tokens are unsigned (a warning is
# logged in production). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
FORM_TOKEN_SECRET=
